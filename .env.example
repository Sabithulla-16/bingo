# BINGO Client Environment Configuration
# Copy this file to .env or pass these as dart-define arguments at build time:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_PUBLISHABLE_KEY=...

# The public URL of your Supabase project instance
SUPABASE_URL=https://your-project-id.supabase.co

# The public anon/publishable key for client-side API access
# WARNING: NEVER commit or expose the service_role key or database admin password!
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key

# Optional App Config
APP_ENVIRONMENT=development
LOG_LEVEL=debug
